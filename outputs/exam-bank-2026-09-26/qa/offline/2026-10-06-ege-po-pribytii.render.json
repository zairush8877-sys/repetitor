      "safeEnd": 1415,
      "creditTop": 1450,
      "last": true,
      "title": {
        "lines": [
          "ЕСЛИ «ПО» =",
          "«ПОСЛЕ»"
        ],
        "size": 116,
        "family": "display"
      },
      "body": {
        "lines": [
          "По прибытии. По завершении. В",
          "этих сочетаниях — предложный",
